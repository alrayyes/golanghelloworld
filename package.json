{
  "name": "golanghelloworld",
  "description": "Just a silly hello world project",
  "scripts": {
    "commit": "cz",
    "markdown:format": "markdownlint -f",
    "markdown:lint": "markdownlint",
    "prettier:format": "prettier --write --ignore-unknown",
    "prettier:lint": "prettier --check --ignore-unknown",
    "prepare": "lefthook install"
  },
  "author": "Ryan Kes <ryan@ryankes.eu>",
  "license": "GPL-3.0-only",
  "lint-staged": {
    "**/*": "bun prettier:format",
    "**/*.md": "bun markdown:format",
    "**/Dockerfile": "docker compose run --rm hadolint hadolint"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "lefthook": "2.1.10",
    "lint-staged": "17.3.0",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.6",
    "prettier-plugin-sort-json": "4.2.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}

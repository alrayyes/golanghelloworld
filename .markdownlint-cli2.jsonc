{
  // Prettier decides layout, so the rules that also have an opinion about it
  // are off. Two tools arguing over the same character is a hook that fails
  // twice and fixes nothing.
  "config": {
    "extends": "markdownlint/style/relaxed",
    "MD004": false,
    "MD007": false,
    "MD012": false,
    "MD049": false,
    "MD050": false
  },
  "globs": ["**/*.md"],
  // LICENSE and the changelog are generated or vendored text. Neither is ours
  // to lay out.
  "ignores": ["LICENSE.md", "CHANGELOG.md", "node_modules/"]
}
